<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Marketer bulk Done posts many fields (up to 200 sites). Article .docx
# uploads are fixed at 10 MB; PHP must allow at least that (64M headroom).
# php_value only inside IfModule — a bare php_value 500s the site when PHP
# is CGI/FPM and the directive is unknown. .user.ini / php.ini still apply.
# LimitRequestBody: LiteSpeed/Apache can 413 a 5 MB body before PHP runs.
LimitRequestBody 67108864
<IfModule lsapi_module>
    php_value max_input_vars 10000
    php_value post_max_size 64M
    php_value upload_max_filesize 64M
</IfModule>
<IfModule LiteSpeed>
    php_value max_input_vars 10000
    php_value post_max_size 64M
    php_value upload_max_filesize 64M
</IfModule>
<IfModule mod_php.c>
    php_value max_input_vars 10000
    php_value post_max_size 64M
    php_value upload_max_filesize 64M
</IfModule>
<IfModule mod_php8.c>
    php_value max_input_vars 10000
    php_value post_max_size 64M
    php_value upload_max_filesize 64M
</IfModule>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Do not 301 POST/PUT/PATCH — browsers drop the body (a 5 MB .docx vanishes).
    RewriteCond %{REQUEST_METHOD} GET
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>