APP_NAME=SEOLinkBuildings
APP_ENV=local
APP_KEY=
APP_DEBUG=false
# Local: keep APP_URL as http://127.0.0.1:8000 (or localhost) so verify
# emails and redirects stay on your machine. Production/staging: set to the
# real public origin (https://your-domain).
APP_URL=http://localhost

# Used only when APP_ENV=production AND APP_URL is still loopback (misconfigured
# deploy). Local/dev ignores this so localhost verify links keep working.
# PUBLIC_APP_URL=https://seolinkbuildings.com

# Only needed when an external cron hits /cron/*. Must be >= 32 chars or those
# routes stay disabled; prefer the built-in scheduler and leave this unset.
CRON_SECRET=

# Who may set X-Forwarded-*. Empty = trust nobody (local). Hostinger behind
# Cloudflare: cloudflare. Never set * — that lets clients pick their own IP.
# TRUSTED_PROXIES=cloudflare

# Hostinger often has no SSH cron. When true (default), production web traffic
# runs migrate --force, writes MEDIA_PATH / APP_URL, and schedule:run after
# the response is flushed. Set false only when a real cron + worker already run.
HOSTINGER_WEB_HEAL=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# This app requires MySQL/MariaDB. SQLite cannot run several production
# migrations (ENUM ALTER TABLE). PHPUnit uses .env.testing (sqlite) instead.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Absolute path to durable public media (sites, screenshots, blogs, banners).
# Empty = default storage/app/public (local/CI). On Hostinger the first
# production page view (or ops:production-ready --repair) writes
# /home/USER/persistent/media — see docs/hostinger-media.md.
MEDIA_PATH=
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_REPLY_TO_ADDRESS=
MAIL_SUPPORT_EMAIL=
MAIL_LOGO_URL=
MAIL_LOGO_PATH=assets/img/email-logo.png
SUPPORT_TELEGRAM_URL=https://t.me/arslan_seolinkbuildings
# Leave unset to follow QUEUE_CONNECTION (needs `php artisan queue:work`).
# Set to "sync" only for environments running without a queue worker.
MAIL_QUEUE_CONNECTION=
# Hostinger: leave true so web traffic + `mail:drain-queue` deliver verify/chat mail.
# Set false only when a resident worker already runs: queue:work --queue=default,emails
MAIL_QUEUE_AUTO_DRAIN=true
# Drop transactional mail older than this when a backlog is finally consumed.
# MAIL_MAX_AGE_HOURS=24
# Campaign mail may sit longer; 0 disables the campaign-only cap.
# MAIL_CAMPAIGN_MAX_AGE_HOURS=72
# Signed marketing unsubscribe links (GET confirm + POST one-click).
# MAIL_UNSUBSCRIBE_EXPIRE_DAYS=30
ADMIN_EMAIL=

# Billing / invoices (PDF seller block + tax defaults)
BILLING_COMPANY_NAME="${APP_NAME}"
BILLING_LEGAL_NAME="SEOLinkBuildings Partners with (Topurlz LTD)"
BILLING_ADDRESS_LINE1="20 Wenlock Road, London, England, N1 7GU"
BILLING_ADDRESS_LINE2=
BILLING_ADDRESS_LINE3=
BILLING_ADDRESS_COUNTRY=
BILLING_SUPPORT_EMAIL="${MAIL_SUPPORT_EMAIL}"
BILLING_WEBSITE_URL="${APP_URL}"
BILLING_VAT_NUMBER=
BILLING_LOGO_PATH=assets/img/email-logo.png
BILLING_CURRENCY=EUR
BILLING_TAX_ENABLED=false
BILLING_TAX_RATE=0
BILLING_TAX_LABEL=VAT
BILLING_INVOICE_PREFIX=INV

# Deposit rails (Add Funds)
BILLING_WISE_PAY_URL=https://wise.com/pay/business/topurlzltd
BILLING_DEPOSIT_CRYPTO_ENABLED=true
BILLING_CRYPTO_USDT_TRC20=TLsBTcjhpqLYKkA5nbha3bEe9CCmpCAeqR
# Optional extra deposit rails (leave empty to hide):
# BILLING_CRYPTO_USDT_BEP20=
# BILLING_CRYPTO_BTC=
# BILLING_CRYPTO_BINANCE_PAY=
# Show Apple Pay logo only when Stripe wallet / domain verification is ready
BILLING_SHOW_APPLE_PAY=false

TRUSTPILOT_REVIEW_URL=https://www.trustpilot.com/review/seolinkbuildings.com
TRUSTPILOT_EVALUATE_URL=https://www.trustpilot.com/evaluate/seolinkbuildings.com
SOCIAL_TWITTER_URL=
SOCIAL_X_URL=
SOCIAL_LINKEDIN_URL=
SOCIAL_FACEBOOK_URL=
SOCIAL_INSTAGRAM_URL=
SOCIAL_YOUTUBE_URL=

# Stripe (required for Credit/Debit card at checkout + Add Funds).
# Dashboard → Developers → API keys: pk_... / sk_...
# Dashboard → Developers → Webhooks: endpoint /api/stripe/webhook, secret whsec_...
# After setting keys on the server: php artisan config:clear
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# PayPal Orders v2 (checkout + Add Funds). On when Client ID + Secret exist.
# Developer Dashboard → Apps: Client ID + Secret (same Sandbox/Live toggle as PAYPAL_MODE).
# Local/testing: PAYPAL_MODE=sandbox + Sandbox REST keys.
# Production: PAYPAL_MODE=live + Live REST keys. Mixing them returns HTTP 401.
# Webhooks: POST /api/paypal/webhook — paste the webhook id from the dashboard.
# PAYPAL_ENABLED=false is an optional kill switch; omit or set true to leave on.
# After setting keys: php artisan config:clear && php artisan paypal:status
# PAYPAL_ENABLED=false
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google OAuth (Laravel Socialite)
# Required for “Continue with Google”. Create an OAuth 2.0 Web client in
# Google Cloud Console and paste the REAL Client ID + Client Secret below
# (not the placeholders “your-id” / “your-secret”).
#
# Authorized redirect URIs must match the browser origin exactly, e.g.:
#   http://127.0.0.1:8000/auth/google/callback
#   http://localhost:8000/auth/google/callback
#   https://seolinkbuildings.com/auth/google/callback
# (The app always sends the current request origin as redirect_uri.)
#
# After editing .env: php artisan config:clear
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
# Production never retries Google login without a valid "state" cookie.
# Leave false. Local/testing already allow the fallback.
GOOGLE_OAUTH_ALLOW_STATELESS=false

# Publisher withdrawal platform fee (%). Keep UI/admin/email in sync via config/billing.php
WITHDRAWAL_FEE_PERCENT=0
WITHDRAWAL_MIN_AMOUNT=20

# Order auto-approve after publisher submits live URL (hours)
ORDER_AUTO_APPROVE_HOURS=72
ORDER_AUTO_APPROVE_REMINDER_HOURS_BEFORE=24
ORDER_AUTO_APPROVE_REQUIRE_LIVE_URL_OK=true

# Content compliance (Google Docs article moderation at checkout)
CONTENT_MODERATION_ENABLED=true
CONTENT_MODERATION_THRESHOLD=70

# Publisher catalog enrichment (SEO metrics + homepage screenshots)
SITE_ENRICHMENT_ENABLED=true
SITE_METRICS_PROVIDER=manual
SITE_METRICS_FALLBACKS=manual
SITE_ENRICHMENT_FREQUENCY=weekly
SITE_ENRICHMENT_MAX_AGE_DAYS=90
SITE_SCREENSHOT_PROVIDER=thum_io
# AHREFS_API_KEY=
# MOZ_ACCESS_TOKEN=
# MOZ_ACCESS_ID=
# MOZ_SECRET_KEY=
# SEMRUSH_API_KEY=
# SCREENSHOTONE_ACCESS_KEY=
# SITE_SCREENSHOT_API_URL=
# SITE_CWEBP_PATH=/usr/bin/cwebp
BILLING_REGISTRATION_NO=16607074
BILLING_VAT_NOTE="Not VAT registered – no VAT charged"
BILLING_DEPOSIT_SELLER_NAME="SEOLinkBuildings Partner"
BILLING_DEPOSIT_BENEFICIARY="Topurlz Ltd"
BILLING_DEPOSIT_BIC=TRWIBEB1XXX
BILLING_DEPOSIT_IBAN=BE04905543949331
BILLING_DEPOSIT_PHONE="+447445152374"
BILLING_DEPOSIT_ADDRESS_LINE1="20 Wenlock Road, London, England, N1 7GU"
BILLING_DEPOSIT_REGISTRATION_NO=16607074

# Advertiser catalog live search (fragment updates while typing). Set false to force full-page navigation.
# CATALOG_LIVE_SEARCH=true

# Admin dashboard JSON cache in seconds (0 = off). Safe rollback: leave unset.
# DASHBOARD_METRICS_CACHE=0
